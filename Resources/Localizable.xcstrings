    "Average response time is %lld ms per operation. Very slow responses can indicate internal retries on weak sectors." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die durchschnittliche Antwortzeit beträgt %lld ms pro Vorgang. Sehr langsame Antworten können auf interne Wiederholungen bei schwachen Sektoren hinweisen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Average response time is %lld ms per operation. Very slow responses can indicate internal retries on weak sectors."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El tiempo medio de respuesta es de %lld ms por operación. Las respuestas muy lentas pueden indicar reintentos internos en sectores débiles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le temps de réponse moyen est de %lld ms par opération. Des réponses très lentes peuvent indiquer des tentatives internes sur des secteurs fragiles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tempo di risposta medio è di %lld ms per operazione. Risposte molto lente possono indicare tentativi interni su settori deboli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "平均応答時間は 1 回の操作あたり %lld ms です。非常に遅い応答は、弱いセクタでの内部リトライを示している可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "작업당 평균 응답 시간은 %lld ms입니다. 응답이 매우 느리면 약한 섹터에서 내부 재시도가 일어나고 있을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tempo médio de resposta é de %lld ms por operação. Respostas muito lentas podem indicar novas tentativas internas em setores fracos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次操作的平均响应时间为 %lld 毫秒。响应非常慢可能表示弱扇区上存在内部重试。"
          }
        }
      }
    },
