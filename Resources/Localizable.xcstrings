    "Minor issues were detected. The drive is usable, but monitor it and keep backups current." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleinere Probleme wurden erkannt. Das Laufwerk ist nutzbar, aber behalte es im Auge und halte deine Backups aktuell."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minor issues were detected. The drive is usable, but monitor it and keep backups current."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detectaron problemas menores. La unidad se puede usar, pero vigílala y mantén las copias de seguridad al día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des problèmes mineurs ont été détectés. Le disque est utilisable, mais surveillez-le et maintenez vos sauvegardes à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono stati rilevati problemi minori. L’unità è utilizzabile, ma tienila sotto controllo e mantieni aggiornati i backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "軽微な問題が検出されました。ドライブは使用できますが、状態を監視し、バックアップを最新に保ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "경미한 문제가 감지되었습니다. 드라이브는 사용할 수 있지만 상태를 지켜보고 백업을 최신으로 유지하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foram detectados problemas menores. A unidade pode ser usada, mas monitore-a e mantenha os backups em dia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测到小问题。驱动器仍可使用，但请注意监控并保持备份最新。"
          }
        }
      }
    },
