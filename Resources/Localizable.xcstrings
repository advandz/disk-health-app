    },
    "The motor needed more than one attempt to reach operating speed — a mechanical or power-supply problem." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Motor brauchte mehr als einen Versuch, um die Betriebsdrehzahl zu erreichen – ein mechanisches oder Stromversorgungsproblem."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The motor needed more than one attempt to reach operating speed — a mechanical or power-supply problem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El motor necesitó más de un intento para alcanzar la velocidad de funcionamiento: un problema mecánico o de alimentación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
