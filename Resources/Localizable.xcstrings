    "Keeping at least 10–15% free helps SSD wear-leveling and file-system performance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestens 10–15 % freier Speicher unterstützt die Verschleißverteilung der SSD und die Leistung des Dateisystems."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeping at least 10–15% free helps SSD wear-leveling and file-system performance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantener al menos un 10–15% libre ayuda a la nivelación de desgaste del SSD y al rendimiento del sistema de archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garder au moins 10–15 % d’espace libre favorise la répartition de l’usure du SSD et les performances du système de fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenere almeno il 10–15% di spazio libero favorisce il bilanciamento dell’usura dell’SSD e le prestazioni del file system."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10〜15% 以上の空き容量を保つと、SSD のウェアレベリングとファイルシステムの性能に役立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최소 10–15%의 여유 공간을 유지하면 SSD 웨어 레벨링과 파일 시스템 성능에 도움이 됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manter pelo menos 10–15% livre ajuda no nivelamento de desgaste do SSD e no desempenho do sistema de arquivos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少保留 10–15% 的可用空间有助于 SSD 磨损均衡和文件系统性能。"
          }
        }
      }
    },
