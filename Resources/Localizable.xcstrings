        }
      }
    },
    "The drive shows signs of degradation. Back up important data and monitor it closely." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Laufwerk zeigt Anzeichen von Verschlechterung. Sichere wichtige Daten und beobachte es genau."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The drive shows signs of degradation. Back up important data and monitor it closely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
