          "stringUnit" : {
            "state" : "translated",
            "value" : "离线扫描期间无法读取的扇区。"
          }
        }
      }
    },
    "Sectors that could not be read during the drive's background scan." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
