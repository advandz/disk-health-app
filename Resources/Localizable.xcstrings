    "S.M.A.R.T. is not accessible for this drive, so the assessment is based on I/O counters and tests only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S.M.A.R.T. ist für dieses Laufwerk nicht zugänglich, daher beruht die Bewertung nur auf E/A-Zählern und Tests."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S.M.A.R.T. is not accessible for this drive, so the assessment is based on I/O counters and tests only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S.M.A.R.T. no es accesible para esta unidad, por lo que la evaluación se basa solo en contadores de E/S y pruebas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S.M.A.R.T. n’est pas accessible pour ce disque ; l’évaluation repose donc uniquement sur les compteurs d’E/S et les tests."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S.M.A.R.T. non è accessibile per questa unità, quindi la valutazione si basa solo sui contatori di I/O e sui test."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
