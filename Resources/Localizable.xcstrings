      }
    },
    "This drive does not expose wear or age data to macOS (no S.M.A.R.T. access), so remaining life cannot be estimated." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Laufwerk stellt macOS keine Verschleiß- oder Altersdaten bereit (kein S.M.A.R.T.-Zugriff), daher kann die Restlebensdauer nicht geschätzt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This drive does not expose wear or age data to macOS (no S.M.A.R.T. access), so remaining life cannot be estimated."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta unidad no expone datos de desgaste ni de antigüedad a macOS (sin acceso S.M.A.R.T.), por lo que no se puede estimar la vida restante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce disque n’expose pas de données d’usure ni d’âge à macOS (pas d’accès S.M.A.R.T.) ; la durée de vie restante ne peut donc pas être estimée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa unità non espone a macOS dati di usura o età (nessun accesso S.M.A.R.T.), quindi non è possibile stimare la vita residua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このドライブは摩耗や経年のデータを macOS に公開していない（S.M.A.R.T. にアクセスできない）ため、残り寿命を推定できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 드라이브는 macOS에 마모나 사용 기간 데이터를 제공하지 않으므로(S.M.A.R.T. 접근 불가) 남은 수명을 추정할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta unidade não expõe dados de desgaste ou idade ao macOS (sem acesso S.M.A.R.T.), por isso a vida restante não pode ser estimada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此驱动器未向 macOS 提供磨损或使用年限数据（无法访问 S.M.A.R.T.），因此无法估算剩余寿命。"
          }
        }
      }
    },
