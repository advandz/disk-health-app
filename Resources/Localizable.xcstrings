    "Regions that took over a second to read usually needed many internal retries — typical of weak or degrading sectors." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bereiche, deren Lesen länger als eine Sekunde dauerte, benötigten meist viele interne Wiederholungen – typisch für schwache oder nachlassende Sektoren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regions that took over a second to read usually needed many internal retries — typical of weak or degrading sectors."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las regiones que tardaron más de un segundo en leerse normalmente necesitaron muchos reintentos internos, algo típico de sectores débiles o en deterioro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les régions dont la lecture a pris plus d’une seconde ont généralement nécessité de nombreuses tentatives internes, ce qui est typique de secteurs fragiles ou en dégradation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le aree che hanno richiesto più di un secondo per la lettura hanno di solito richiesto molti tentativi interni, tipico di settori deboli o in deterioramento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読み取りに 1 秒以上かかった領域は、通常、多くの内部リトライを必要としています。弱いセクタや劣化しつつあるセクタに典型的な症状です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "읽는 데 1초 넘게 걸린 영역은 대개 많은 내부 재시도가 필요했던 것으로, 약하거나 열화되는 섹터의 전형적인 증상입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regiões que levaram mais de um segundo para serem lidas geralmente precisaram de muitas novas tentativas internas, o que é típico de setores fracos ou em degradação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取时间超过一秒的区域通常需要大量内部重试，这是扇区薄弱或正在退化的典型表现。"
          }
        }
      }
    },
