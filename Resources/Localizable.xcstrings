    "Less than 1%% of rated endurance used after %lld power-on hours; this is a lower bound at an assumed %@ powered-on hours per day (refines as history accumulates)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weniger als 1 %% der spezifizierten Ausdauer nach %lld Betriebsstunden verbraucht; dies ist eine Untergrenze bei angenommenen %@ Betriebsstunden pro Tag (wird mit wachsendem Verlauf genauer)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Less than 1%% of rated endurance used after %lld power-on hours; this is a lower bound at an assumed %@ powered-on hours per day (refines as history accumulates)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos del 1%% de la resistencia nominal usada tras %lld horas de funcionamiento; es un límite inferior con un uso supuesto de %@ horas encendida al día (se ajusta a medida que se acumula historial)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moins de 1 %% de l’endurance nominale utilisée après %lld heures de fonctionnement ; il s’agit d’une limite basse pour une utilisation estimée à %@ heures sous tension par jour (s’affine à mesure que l’historique s’accumule)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meno dell’1%% della resistenza nominale utilizzata dopo %lld ore di accensione; è un limite inferiore con un utilizzo stimato di %@ ore di accensione al giorno (si affina man mano che si accumula la cronologia)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld 時間の稼働後も定格耐久性の使用は 1%% 未満です。これは 1 日あたりの通電時間を %2$@ 時間と仮定した場合の下限値です（履歴が蓄積されると精度が上がります）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전원 켜짐 %1$lld시간 후 정격 내구성의 1%% 미만을 사용했습니다. 이는 하루 %2$@시간 전원이 켜져 있다고 가정한 하한값입니다(기록이 쌓일수록 정확해집니다)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos de 1%% da resistência nominal usada após %lld horas de funcionamento; este é um limite inferior com uso estimado de %@ horas ligada por dia (fica mais preciso à medida que o histórico se acumula)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通电 %1$lld 小时后，额定耐久度使用不足 1%%；这是假设每天通电 %2$@ 小时的下限值（随着历史记录积累会更准确）。"
          }
        }
      }
    },
    "Less than 1%% of rated endurance used after %lld power-on hours; this is a lower bound at the observed usage of %@ powered-on hours per day." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weniger als 1 %% der spezifizierten Ausdauer nach %lld Betriebsstunden verbraucht; dies ist eine Untergrenze bei beobachteten %@ Betriebsstunden pro Tag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Less than 1%% of rated endurance used after %lld power-on hours; this is a lower bound at the observed usage of %@ powered-on hours per day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos del 1%% de la resistencia nominal usada tras %lld horas de funcionamiento; es un límite inferior con el uso observado de %@ horas encendida al día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moins de 1 %% de l’endurance nominale utilisée après %lld heures de fonctionnement ; il s’agit d’une limite basse pour l’utilisation observée de %@ heures sous tension par jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meno dell’1%% della resistenza nominale utilizzata dopo %lld ore di accensione; è un limite inferiore con l’utilizzo osservato di %@ ore di accensione al giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld 時間の稼働後も定格耐久性の使用は 1%% 未満です。これは 1 日あたりの実測通電時間 %2$@ 時間に基づく下限値です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전원 켜짐 %1$lld시간 후 정격 내구성의 1%% 미만을 사용했습니다. 이는 실측된 하루 %2$@시간 사용량을 적용한 하한값입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos de 1%% da resistência nominal usada após %lld horas de funcionamento; este é um limite inferior com o uso observado de %@ horas ligada por dia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通电 %1$lld 小时后，额定耐久度使用不足 1%%；这是按实测每天通电 %2$@ 小时计算的下限值。"
          }
        }
      }
    },
