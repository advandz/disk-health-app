    "Data was corrupted in transit between drive and computer. This points to the cable, connector or enclosure rather than the drive itself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Daten wurden bei der Übertragung zwischen Laufwerk und Computer beschädigt. Das deutet eher auf Kabel, Anschluss oder Gehäuse als auf das Laufwerk selbst hin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data was corrupted in transit between drive and computer. This points to the cable, connector or enclosure rather than the drive itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos se dañaron durante la transferencia entre la unidad y el ordenador. Esto apunta al cable, el conector o la carcasa más que a la propia unidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des données ont été corrompues lors du transfert entre le disque et l’ordinateur. Cela met en cause le câble, le connecteur ou le boîtier plutôt que le disque lui-même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati sono stati danneggiati durante il trasferimento tra unità e computer. Ciò indica il cavo, il connettore o il contenitore piuttosto che l’unità stessa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドライブとコンピュータ間の転送中にデータが破損しました。ドライブ本体よりも、ケーブル、コネクタ、ケースに問題がある可能性が高いです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드라이브와 컴퓨터 간 전송 중에 데이터가 손상되었습니다. 드라이브 자체보다는 케이블, 커넥터 또는 인클로저에 문제가 있음을 나타냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dados foram corrompidos na transferência entre a unidade e o computador. Isso aponta para o cabo, o conector ou o gabinete, e não para a unidade em si."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据在驱动器与电脑之间传输时损坏。这表明问题在于数据线、接口或硬盘盒，而非驱动器本身。"
          }
        }
      }
    },
