    "Improve airflow, reduce load, or move the drive away from heat sources." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbessere die Luftzirkulation, verringere die Last oder entferne das Laufwerk von Wärmequellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Improve airflow, reduce load, or move the drive away from heat sources."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejora la ventilación, reduce la carga o aleja la unidad de fuentes de calor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Améliorez la circulation d’air, réduisez la charge ou éloignez le disque des sources de chaleur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Migliora la circolazione dell’aria, riduci il carico o allontana l’unità da fonti di calore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通気を改善するか、負荷を減らすか、ドライブを熱源から離してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통풍을 개선하거나 부하를 줄이거나 드라이브를 열원에서 멀리 두십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melhore a circulação de ar, reduza a carga ou afaste a unidade de fontes de calor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "改善通风、降低负载或使驱动器远离热源。"
          }
        }
      }
    },
    "Improve cooling and avoid sustained heavy writes until temperatures drop." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbessere die Kühlung und vermeide anhaltende hohe Schreiblast, bis die Temperatur sinkt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Improve cooling and avoid sustained heavy writes until temperatures drop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejora la refrigeración y evita escrituras intensas prolongadas hasta que bajen las temperaturas."
          }
        },
        "fr" : {
