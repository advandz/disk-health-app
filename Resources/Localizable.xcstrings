    "%lld%% of rated write endurance used." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld %% der spezifizierten Schreibausdauer verbraucht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld%% of rated write endurance used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld%% de la resistencia de escritura nominal usada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld %% de l’endurance en écriture nominale utilisés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld%% della resistenza in scrittura nominale utilizzata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定格書き込み耐久性の %lld%% を使用済みです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정격 쓰기 내구성의 %lld%%를 사용했습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld%% da resistência de gravação nominal usada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已使用额定写入寿命的 %lld%%。"
          }
        }
      }
    },
    "%lld%% of rated write endurance used. The NAND has exceeded its manufacturer-rated life; failure risk rises sharply from here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld %% der spezifizierten Schreibausdauer verbraucht. Der NAND-Speicher hat die vom Hersteller spezifizierte Lebensdauer überschritten; das Ausfallrisiko steigt ab jetzt stark an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld%% of rated write endurance used. The NAND has exceeded its manufacturer-rated life; failure risk rises sharply from here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld%% de la resistencia de escritura nominal usada. La memoria NAND ha superado la vida útil nominal del fabricante; a partir de aquí el riesgo de fallo aumenta considerablemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld %% de l’endurance en écriture nominale utilisés. La mémoire NAND a dépassé la durée de vie nominale du fabricant ; le risque de défaillance augmente fortement à partir de maintenant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld%% della resistenza in scrittura nominale utilizzata. La NAND ha superato la durata nominale indicata dal produttore; da qui il rischio di guasto aumenta drasticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "定格書き込み耐久性の %lld%% を使用済みです。NAND はメーカーの定格寿命を超えており、ここから故障のリスクが急激に高まります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정격 쓰기 내구성의 %lld%%를 사용했습니다. NAND가 제조사 정격 수명을 넘었으며, 이제부터 고장 위험이 급격히 높아집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld%% da resistência de gravação nominal usada. A memória NAND ultrapassou a vida útil nominal do fabricante; a partir daqui o risco de falha aumenta muito."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已使用额定写入寿命的 %lld%%。NAND 已超过制造商的额定寿命，从现在起故障风险将急剧上升。"
          }
        }
      }
    },
