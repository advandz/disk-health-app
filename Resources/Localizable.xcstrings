            "state" : "translated",
            "value" : "Die meisten Festplatten sind für etwa 5 Jahre Betrieb ausgelegt; danach steigen die Ausfallraten stark an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most hard drives are designed for about 5 years of service; failure rates rise steeply beyond that."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mayoría de los discos duros están diseñados para unos 5 años de servicio; a partir de ahí la tasa de fallos aumenta considerablemente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La plupart des disques durs sont conçus pour environ 5 ans de service ; au-delà, le taux de défaillance augmente fortement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La maggior parte dei dischi rigidi è progettata per circa 5 anni di servizio; oltre, il tasso di guasto aumenta drasticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほとんどのハードディスクは約 5 年の使用を想定して設計されており、それを超えると故障率が急上昇します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대부분의 하드 드라이브는 약 5년간 사용하도록 설계되었으며, 그 이후에는 고장률이 급격히 높아집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A maioria dos discos rígidos é projetada para cerca de 5 anos de serviço; depois disso, a taxa de falhas aumenta muito."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大多数硬盘的设计使用寿命约为 5 年；超过之后故障率会急剧上升。"
          }
        }
      }
    },
