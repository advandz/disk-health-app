    "Operating hard drives below 5 °C increases mechanical stress." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Betrieb von Festplatten unter 5 °C erhöht die mechanische Belastung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Operating hard drives below 5 °C increases mechanical stress."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar discos duros por debajo de 5 °C aumenta la tensión mecánica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser des disques durs en dessous de 5 °C accroît les contraintes mécaniques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizzare dischi rigidi sotto i 5 °C aumenta lo stress meccanico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 °C 未満でハードディスクを動作させると機械的な負荷が増加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "5 °C 미만에서 하드 드라이브를 작동하면 기계적 스트레스가 커집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
