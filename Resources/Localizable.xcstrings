    "The test was stopped before it finished and found no problems, so the previous result is kept." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The test was stopped before it finished and found no problems, so the previous result is kept."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Test wurde vor dem Ende gestoppt und hat keine Probleme gefunden, daher bleibt das vorherige Ergebnis erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prueba se detuvo antes de terminar y no encontró problemas, así que se conserva el resultado anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
