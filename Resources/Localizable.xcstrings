    "Above the %lld °C critical limit. Sustained heat accelerates wear and can cause data errors or throttling." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über der kritischen Grenze von %lld °C. Anhaltende Hitze beschleunigt den Verschleiß und kann Datenfehler oder Drosselung verursachen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Above the %lld °C critical limit. Sustained heat accelerates wear and can cause data errors or throttling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por encima del límite crítico de %lld °C. El calor sostenido acelera el desgaste y puede provocar errores de datos o limitación del rendimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au-dessus de la limite critique de %lld °C. Une chaleur prolongée accélère l’usure et peut provoquer des erreurs de données ou un bridage des performances."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oltre il limite critico di %lld °C. Il calore prolungato accelera l’usura e può causare errori nei dati o riduzione delle prestazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "危険温度の上限 %lld °C を超えています。高温が続くと摩耗が早まり、データエラーやスロットリングの原因になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위험 한계인 %lld °C를 넘었습니다. 고온이 지속되면 마모가 빨라지고 데이터 오류나 성능 제한이 발생할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acima do limite crítico de %lld °C. O calor prolongado acelera o desgaste e pode causar erros de dados ou redução de desempenho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超过 %lld °C 的临界上限。持续高温会加速磨损，并可能导致数据错误或降频。"
          }
        }
      }
    },
