    "Avoid force-restarts and unplugging without ejecting; frequent power loss risks file-system corruption." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermeide erzwungene Neustarts und das Trennen ohne Auswerfen; häufige Stromausfälle können das Dateisystem beschädigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avoid force-restarts and unplugging without ejecting; frequent power loss risks file-system corruption."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita los reinicios forzados y desconectar sin expulsar; los cortes de corriente frecuentes pueden dañar el sistema de archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évitez les redémarrages forcés et les débranchements sans éjection ; des coupures de courant fréquentes risquent de corrompre le système de fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evita i riavvii forzati e di scollegare senza espellere; frequenti interruzioni di corrente rischiano di danneggiare il file system."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強制再起動や取り出し操作なしでの取り外しは避けてください。頻繁な電源断はファイルシステム破損の原因になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "강제 재시동과 추출하지 않고 분리하는 것을 피하십시오. 잦은 전원 차단은 파일 시스템을 손상시킬 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evite reinicializações forçadas e desconectar sem ejetar; quedas de energia frequentes podem corromper o sistema de arquivos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "避免强制重启和未推出就拔出；频繁断电可能损坏文件系统。"
          }
        }
      }
    },
