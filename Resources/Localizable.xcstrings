    "Requests had to be retried before they succeeded — a sign of marginal sectors, a weak connection or power issues." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anforderungen mussten wiederholt werden, bevor sie erfolgreich waren – ein Zeichen für grenzwertige Sektoren, eine schwache Verbindung oder Stromprobleme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requests had to be retried before they succeeded — a sign of marginal sectors, a weak connection or power issues."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las solicitudes tuvieron que reintentarse antes de completarse: señal de sectores marginales, una conexión débil o problemas de alimentación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des requêtes ont dû être relancées avant d’aboutir : signe de secteurs limites, d’une connexion faible ou de problèmes d’alimentation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le richieste sono state ripetute prima di riuscire: segno di settori marginali, di una connessione debole o di problemi di alimentazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要求が成功するまでにリトライが必要でした。境界的なセクタ、弱い接続、または電源の問題の兆候です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청이 성공하기 전에 재시도해야 했습니다. 한계 섹터, 약한 연결 또는 전원 문제의 징후입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As solicitações tiveram de ser repetidas antes de serem concluídas, um sinal de setores marginais, conexão fraca ou problemas de energia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求在成功前需要重试——这表明存在临界扇区、连接不良或电源问题。"
          }
        }
      }
    },
