    "Reduce write-heavy workloads (swap, caches, video editing scratch) or plan a replacement." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduziere schreibintensive Lasten (Auslagerung, Caches, Arbeitsdateien für Videoschnitt) oder plane einen Austausch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce write-heavy workloads (swap, caches, video editing scratch) or plan a replacement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce las cargas con muchas escrituras (swap, cachés, archivos temporales de edición de vídeo) o planifica una sustitución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduisez les charges d’écriture intensives (swap, caches, fichiers temporaires de montage vidéo) ou prévoyez un remplacement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riduci i carichi con molte scritture (swap, cache, file temporanei di montaggio video) o pianifica una sostituzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書き込みの多い処理（スワップ、キャッシュ、ビデオ編集の作業ファイルなど）を減らすか、交換を計画してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "쓰기가 많은 작업(스왑, 캐시, 동영상 편집 임시 파일)을 줄이거나 교체를 계획하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduza cargas com muitas gravações (swap, caches, arquivos temporários de edição de vídeo) ou planeje uma substituição."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "减少大量写入的负载（交换文件、缓存、视频剪辑临时文件），或计划更换。"
          }
        }
      }
    },
