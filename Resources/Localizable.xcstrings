    "S.M.A.R.T. data could not be read (IOReturn %@). S.M.A.R.T. may be turned off on this drive; Disk Health leaves that setting unchanged." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S.M.A.R.T. data could not be read (IOReturn %@). S.M.A.R.T. may be turned off on this drive; Disk Health leaves that setting unchanged."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S.M.A.R.T.-Daten konnten nicht gelesen werden (IOReturn %@). Möglicherweise ist S.M.A.R.T. auf diesem Laufwerk deaktiviert; Disk Health ändert diese Einstellung nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron leer los datos S.M.A.R.T. (IOReturn %@). Puede que S.M.A.R.T. esté desactivado en esta unidad; Disk Health no cambia ese ajuste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire les données S.M.A.R.T. (IOReturn %@). S.M.A.R.T. est peut-être désactivé sur ce disque ; Disk Health ne modifie pas ce réglage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere i dati S.M.A.R.T. (IOReturn %@). S.M.A.R.T. potrebbe essere disattivato su questa unità; Disk Health non modifica questa impostazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S.M.A.R.T. データを読み取れませんでした（IOReturn %@）。このドライブでは S.M.A.R.T. がオフになっている可能性があります。Disk Health はこの設定を変更しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S.M.A.R.T. 데이터를 읽을 수 없습니다(IOReturn %@). 이 드라이브에서 S.M.A.R.T.가 꺼져 있을 수 있습니다. Disk Health는 이 설정을 변경하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler os dados S.M.A.R.T. (IOReturn %@). O S.M.A.R.T. pode estar desativado nesta unidade; o Disk Health não altera essa configuração."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 S.M.A.R.T. 数据（IOReturn %@）。此驱动器可能已关闭 S.M.A.R.T.；Disk Health 不会更改此设置。"
          }
        }
      }
    },
