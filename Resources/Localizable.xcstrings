    "The controller detected unrecovered data integrity errors (ECC/CRC failures, LBA tag mismatches). Healthy drives report 0." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Controller hat nicht behobene Datenintegritätsfehler erkannt (ECC-/CRC-Fehler, LBA-Tag-Abweichungen). Gesunde Laufwerke melden 0."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
