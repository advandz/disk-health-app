        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모터가 작동 속도에 도달하는 데 두 번 이상 시도해야 했습니다. 기계적 문제나 전원 공급 문제입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O motor precisou de mais de uma tentativa para atingir a velocidade de operação, um problema mecânico ou de alimentação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
