            "state" : "translated",
            "value" : "%3$@ 以降、%1$lld から %2$lld に増加しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@ 이후 %1$lld에서 %2$lld(으)로 증가했습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumentou de %lld para %lld desde %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自 %3$@ 以来从 %1$lld 增至 %2$lld。"
          }
        }
      }
    },
    "Grew from %lld to %lld since %@. Actively growing defects indicate progressive media failure." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit %3$@ von %1$lld auf %2$lld gestiegen. Aktiv zunehmende Defekte deuten auf einen fortschreitenden Medienausfall hin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grew from %lld to %lld since %@. Actively growing defects indicate progressive media failure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumentó de %lld a %lld desde el %@. Los defectos en aumento indican un fallo progresivo del medio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passé de %lld à %lld depuis le %@. Des défauts en augmentation indiquent une défaillance progressive du support."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumentati da %lld a %lld dal %@. Difetti in crescita indicano un guasto progressivo del supporto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@ 以降、%1$lld から %2$lld に増加しました。欠陥が増え続けているのは、メディアの故障が進行していることを示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@ 이후 %1$lld에서 %2$lld(으)로 증가했습니다. 결함이 계속 늘어나는 것은 미디어 고장이 진행 중임을 나타냅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumentou de %lld para %lld desde %@. Defeitos em crescimento indicam falha progressiva da mídia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自 %3$@ 以来从 %1$lld 增至 %2$lld。缺陷持续增加表明介质正在逐步损坏。"
          }
        }
      }
    },
