    "Wear increased %lld%% in %lld days; at this rate rated endurance is exhausted in about %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Verschleiß ist in %2$lld Tagen um %1$lld %% gestiegen; bei diesem Tempo ist die spezifizierte Ausdauer in etwa %3$@ erschöpft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wear increased %lld%% in %lld days; at this rate rated endurance is exhausted in about %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El desgaste aumentó un %lld%% en %lld días; a este ritmo la resistencia nominal se agotará en unos %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’usure a augmenté de %lld %% en %lld jours ; à ce rythme, l’endurance nominale sera épuisée dans environ %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’usura è aumentata del %lld%% in %lld giorni; a questo ritmo la resistenza nominale si esaurirà in circa %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld 日間で摩耗が %1$lld%% 進みました。このペースでは約 %3$@ で定格耐久性を使い切ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld일 동안 마모가 %1$lld%% 증가했습니다. 이 속도라면 약 %3$@ 후 정격 내구성이 소진됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O desgaste aumentou %lld%% em %lld dias; nesse ritmo, a resistência nominal se esgotará em cerca de %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磨损在 %2$lld 天内增加了 %1$lld%%；按此速度，额定耐久度将在约 %3$@ 后耗尽。"
          }
        }
      }
    },
