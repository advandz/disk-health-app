        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드라이브에 성능 저하 징후가 있습니다. 중요한 데이터를 백업하고 면밀히 지켜보십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
