          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El controlador detectó errores de integridad de datos no recuperados (fallos de ECC/CRC, discrepancias de etiquetas LBA). Las unidades en buen estado indican 0."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contrôleur a détecté des erreurs d’intégrité des données non récupérées (échecs ECC/CRC, incohérences de balises LBA). Les disques sains indiquent 0."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
