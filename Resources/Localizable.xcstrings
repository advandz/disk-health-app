    "The volatile memory backup device has failed. Data in flight may be lost on power failure." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Sicherungsgerät für den flüchtigen Speicher ist ausgefallen. Daten im Schreibvorgang können bei Stromausfall verloren gehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The volatile memory backup device has failed. Data in flight may be lost on power failure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo de respaldo de la memoria volátil ha fallado. Los datos en tránsito podrían perderse en un corte de corriente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dispositif de sauvegarde de la mémoire volatile est défaillant. Les données en cours d’écriture peuvent être perdues en cas de coupure de courant."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo di backup della memoria volatile si è guastato. I dati in transito potrebbero andare persi in caso di interruzione di corrente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "揮発性メモリのバックアップデバイスが故障しました。電源断時に処理中のデータが失われる可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휘발성 메모리 백업 장치가 고장 났습니다. 전원이 끊기면 처리 중인 데이터가 손실될 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dispositivo de backup da memória volátil falhou. Dados em trânsito podem ser perdidos em caso de queda de energia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "易失性内存备份装置已失效。断电时正在传输的数据可能会丢失。"
          }
        }
      }
    },
