    "Health history is stored locally in ~/Library/Application Support/DiskHealth. Nothing leaves this Mac." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zustandsverlauf wird lokal in ~/Library/Application Support/DiskHealth gespeichert. Nichts verlässt diesen Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health history is stored locally in ~/Library/Application Support/DiskHealth. Nothing leaves this Mac."
          }
        },
