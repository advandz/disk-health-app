    "Entries in the controller's error information log. Often caused by benign command errors (e.g. unsupported requests) rather than media problems." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einträge im Fehlerprotokoll des Controllers. Oft durch harmlose Befehlsfehler (z. B. nicht unterstützte Anforderungen) statt durch Medienprobleme verursacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entries in the controller's error information log. Often caused by benign command errors (e.g. unsupported requests) rather than media problems."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entradas del registro de información de errores del controlador. Suelen deberse a errores de comandos inofensivos (p. ej., solicitudes no admitidas) y no a problemas del medio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrées du journal d’erreurs du contrôleur. Souvent dues à des erreurs de commande sans gravité (p. ex. requêtes non prises en charge) plutôt qu’à des problèmes de support."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voci nel registro errori del controller. Spesso causate da errori di comando innocui (ad es. richieste non supportate) piuttosto che da problemi del supporto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントローラのエラー情報ログのエントリです。多くはメディアの問題ではなく、無害なコマンドエラー（未対応の要求など）が原因です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컨트롤러 오류 정보 로그의 항목입니다. 대개 미디어 문제보다는 무해한 명령 오류(예: 지원되지 않는 요청)로 인해 발생합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entradas no registro de informações de erro do controlador. Geralmente causadas por erros de comando inofensivos (por exemplo, solicitações não suportadas), e não por problemas de mídia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制器错误信息日志中的条目。通常由无害的命令错误（例如不支持的请求）引起，而非介质问题。"
          }
        }
      }
    },
