    "Typical drives are rated for 300,000–600,000 load cycles. Aggressive head parking accelerates mechanical wear." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typische Laufwerke sind für 300.000–600.000 Ladezyklen ausgelegt. Aggressives Parken der Köpfe beschleunigt den mechanischen Verschleiß."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typical drives are rated for 300,000–600,000 load cycles. Aggressive head parking accelerates mechanical wear."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las unidades típicas están diseñadas para 300.000–600.000 ciclos de carga. Un aparcamiento agresivo del cabezal acelera el desgaste mecánico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les disques courants sont conçus pour 300 000 à 600 000 cycles de chargement. Un parcage agressif des têtes accélère l’usure mécanique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le unità tipiche sono progettate per 300.000–600.000 cicli di carico. Un parcheggio aggressivo delle testine accelera l’usura meccanica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一般的なドライブのロード回数の定格は 30 万〜60 万回です。積極的なヘッド退避は機械的な摩耗を早めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일반적인 드라이브의 로드 주기 정격은 30만~60만 회입니다. 공격적인 헤드 파킹은 기계적 마모를 가속합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unidades típicas são projetadas para 300.000–600.000 ciclos de carga. O estacionamento agressivo do cabeçote acelera o desgaste mecânico."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "典型驱动器的额定加载次数为 30 万–60 万次。频繁的磁头停靠会加速机械磨损。"
          }
        }
      }
    },
