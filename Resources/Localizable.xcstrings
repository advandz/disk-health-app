        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予備領域残量は %3$@ 以降、%1$lld%% から %2$lld%% に減少しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@ 이후 사용 가능한 예비 공간이 %1$lld%%에서 %2$lld%%로 줄었습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
