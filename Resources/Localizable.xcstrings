    "Sectors found bad and remapped to spares. Any growth is a strong failure predictor." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als defekt erkannte und auf Reserve umgelagerte Sektoren. Jeder Anstieg ist ein starkes Ausfallanzeichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sectors found bad and remapped to spares. Any growth is a strong failure predictor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sectores detectados como defectuosos y reasignados a reservas. Cualquier aumento es un fuerte indicador de fallo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secteurs détectés comme défectueux et réaffectés aux réserves. Toute augmentation est un fort indicateur de panne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settori rilevati come danneggiati e rimappati nelle riserve. Qualsiasi aumento è un forte indicatore di guasto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不良と判定され予備に代替されたセクタ。増加は故障の強い兆候です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "불량으로 감지되어 예비 영역으로 재매핑된 섹터. 증가하면 고장의 강력한 징후입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setores detectados como defeituosos e remapeados para reservas. Qualquer aumento é um forte indicador de falha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "被检测为坏扇区并已重新映射到备用区的扇区。任何增长都是强烈的故障预兆。"
          }
        }
      }
    },
    "Sectors that could not be read during off-line scan." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sektoren, die beim Offline-Scan nicht gelesen werden konnten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
