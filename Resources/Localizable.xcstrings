          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "测试在完成前已停止且未发现问题，因此保留之前的结果。"
          }
        }
      }
    },
    "The test was stopped too early to give a result." : {
