    "Available spare (%lld%%) has fallen below the drive's threshold (%lld%%). The drive is running out of replacement blocks." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die verfügbare Reserve (%lld %%) ist unter den Schwellenwert des Laufwerks (%lld %%) gefallen. Dem Laufwerk gehen die Ersatzblöcke aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Available spare (%lld%%) has fallen below the drive's threshold (%lld%%). The drive is running out of replacement blocks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reserva disponible (%lld%%) ha caído por debajo del umbral de la unidad (%lld%%). La unidad se está quedando sin bloques de sustitución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réserve disponible (%lld %%) est passée sous le seuil du disque (%lld %%). Le disque manque de blocs de remplacement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La riserva disponibile (%lld%%) è scesa sotto la soglia dell’unità (%lld%%). L’unità sta esaurendo i blocchi sostitutivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予備領域残量（%lld%%）がドライブのしきい値（%lld%%）を下回りました。代替ブロックが不足しつつあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용 가능한 예비 공간(%lld%%)이 드라이브 임계값(%lld%%) 아래로 떨어졌습니다. 드라이브의 대체 블록이 부족해지고 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A reserva disponível (%lld%%) caiu abaixo do limite da unidade (%lld%%). A unidade está ficando sem blocos de substituição."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可用备用空间（%lld%%）已低于驱动器阈值（%lld%%）。驱动器的替换块即将耗尽。"
          }
        }
      }
    },
    "Available spare fell from %lld%% to %lld%% since %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die verfügbare Reserve ist seit %3$@ von %1$lld %% auf %2$lld %% gesunken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
