    "Pre-failure attribute #%lld is at %lld (threshold %lld). The drive predicts failure on this parameter." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorausfall-Attribut #%lld liegt bei %lld (Schwellenwert %lld). Das Laufwerk sagt bei diesem Parameter einen Ausfall voraus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pre-failure attribute #%lld is at %lld (threshold %lld). The drive predicts failure on this parameter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El atributo de prefallo #%lld está en %lld (umbral %lld). La unidad predice un fallo en este parámetro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’attribut de pré-défaillance n° %lld est à %lld (seuil %lld). Le disque prévoit une défaillance sur ce paramètre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’attributo di pre-guasto n. %lld è a %lld (soglia %lld). L’unità prevede un guasto su questo parametro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "故障予兆属性 #%lld は %lld です（しきい値 %lld）。ドライブはこのパラメータで故障を予測しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고장 전조 속성 #%lld이(가) %lld입니다(임계값 %lld). 드라이브가 이 항목에서 고장을 예측합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O atributo de pré-falha nº %lld está em %lld (limite %lld). A unidade prevê falha neste parâmetro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "故障前兆属性 #%lld 当前为 %lld（阈值 %lld）。驱动器预测此参数将发生故障。"
          }
        }
      }
    },
    "Pre-failure indicators detected. This drive is at high risk of failing soon — back up now and plan a replacement." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vorausfall-Indikatoren erkannt. Bei diesem Laufwerk besteht ein hohes Risiko, dass es bald ausfällt – jetzt sichern und einen Austausch planen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pre-failure indicators detected. This drive is at high risk of failing soon — back up now and plan a replacement."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detectaron indicadores de prefallo. Esta unidad tiene un alto riesgo de fallar pronto: haz una copia de seguridad ahora y planifica una sustitución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicateurs de pré-défaillance détectés. Ce disque présente un risque élevé de panne prochaine : sauvegardez maintenant et prévoyez un remplacement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilevati indicatori di pre-guasto. Questa unità è ad alto rischio di guasto imminente: esegui subito un backup e pianifica una sostituzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "故障予兆が検出されました。このドライブは近いうちに故障する危険性が高いです。今すぐバックアップし、交換を計画してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고장 전조가 감지되었습니다. 이 드라이브는 곧 고장 날 위험이 높습니다. 지금 백업하고 교체를 계획하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indicadores de pré-falha detectados. Esta unidade tem alto risco de falhar em breve: faça backup agora e planeje uma substituição."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测到故障前兆。此驱动器很可能即将发生故障——请立即备份并计划更换。"
          }
        }
      }
    },
    "Pre-failure — may fail soon" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausfallgefahr – kann bald ausfallen"
