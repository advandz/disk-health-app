          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settori non leggibili durante la scansione offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフラインスキャン中に読み取れなかったセクタ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
