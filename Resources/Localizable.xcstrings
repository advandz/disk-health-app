    "Extrapolated from %lld%% wear over %lld power-on hours, at an assumed %@ powered-on hours per day (refines as history accumulates)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hochgerechnet aus %lld %% Verschleiß über %lld Betriebsstunden bei angenommenen %@ Betriebsstunden pro Tag (wird mit wachsendem Verlauf genauer)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrapolated from %lld%% wear over %lld power-on hours, at an assumed %@ powered-on hours per day (refines as history accumulates)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrapolado a partir de un %lld%% de desgaste en %lld horas de funcionamiento, con un uso supuesto de %@ horas encendida al día (se ajusta a medida que se acumula historial)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrapolé à partir de %lld %% d’usure sur %lld heures de fonctionnement, pour une utilisation estimée à %@ heures sous tension par jour (s’affine à mesure que l’historique s’accumule)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrapolata da un’usura del %lld%% su %lld ore di accensione, con un utilizzo stimato di %@ ore di accensione al giorno (si affina man mano che si accumula la cronologia)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld 時間の稼働で %1$lld%% 摩耗したことから推定しています。1 日あたりの通電時間は %3$@ 時間と仮定しています（履歴が蓄積されると精度が上がります）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전원 켜짐 %2$lld시간 동안 %1$lld%% 마모된 것을 바탕으로 추정했으며, 하루 %3$@시간 전원이 켜져 있다고 가정했습니다(기록이 쌓일수록 정확해집니다)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrapolado a partir de %lld%% de desgaste em %lld horas de funcionamento, com uso estimado de %@ horas ligada por dia (fica mais preciso à medida que o histórico se acumula)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据 %2$lld 个通电小时内 %1$lld%% 的磨损推算，假设每天通电 %3$@ 小时（随着历史记录积累会更准确）。"
          }
        }
      }
    },
    "Extrapolated from %lld%% wear over %lld power-on hours, at the observed usage of %@ powered-on hours per day." : {
